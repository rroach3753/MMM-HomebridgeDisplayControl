# Supply these to the MagicMirror process, not browser-side config.js.
# This file is an example, not automatically loaded.
HBDC_ENABLED=false
HOMEBRIDGE_URL=https://homebridge.local:8581
HOMEBRIDGE_USERNAME=your-username
HOMEBRIDGE_PASSWORD=your-password
HOMEBRIDGE_VERIFY_SSL=true
# JSON array of exact accessory or service names; no sensors selected by default.
HBDC_SENSOR_NAMES=[]
HBDC_OFF_DELAY_MS=300000
HBDC_POLL_INTERVAL_MS=15000
# auto, wayland, or x11
HBDC_BACKEND=auto
# Required for Wayland; obtain the connector name with wlr-randr.
# HBDC_OUTPUT=HDMI-A-1
# Set these if MagicMirror does not inherit the desktop session environment.
# XDG_RUNTIME_DIR=/run/user/1000
# WAYLAND_DISPLAY=wayland-0
# DISPLAY=:0
# XAUTHORITY=/home/your-user/.Xauthority
